# Broker address: use localhost when Mosquitto runs on this same machine.
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
MQTT_DATA_TOPIC=esp32/tof_light_soil_data
MQTT_STATUS_TOPIC=esp32/tof_light_soil_status

# Calibration from this sensor: fully dry is 2527, fully wet is 1237.
# Change these if you recalibrate the probe.
SOIL_DRY_RAW=2527
SOIL_WET_RAW=1237

# Database is created automatically. Use an absolute persistent path on the Pi if desired.
# SENSOR_DB_PATH=/home/pi/ut-cms/backend/sensor_readings.sqlite3

# For Expo web, narrow this to your web app origin in production.
CORS_ORIGINS=*
